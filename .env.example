NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/gridpulse
# Replace this local-development secret before deploying anywhere.
JWT_ACCESS_SECRET=local-development-access-secret-change-before-deploy-2026
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# Generate and keep this key private; used to encrypt IoT gateway signing secrets at rest.
INTEGRATION_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Run organization alert evaluations every 5 minutes (0 disables the worker).
ALERT_EVALUATION_INTERVAL_SECONDS=300
# Distributed worker lease; automatically renewed while evaluation is running.
ALERT_EVALUATION_LEASE_SECONDS=180
